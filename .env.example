# Server-side provider key for image description and multimodal fallback
# Get an API key from https://www.orcarouter.ai/
ORCAROUTER_API_KEY=

# Server-side provider key for smart chat and multimodal fallback
# Get an API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Private admin console password. Keep server-side only; do not expose via PUBLIC_* variables.
ADMIN_PASSWORD=

# HMAC secret for admin session cookies. Use a long random value in production.
# Generate one with: openssl rand -base64 48
ADMIN_SESSION_SECRET=

# Remote Astro DB / LibSQL connection used by audit logs and model-control persistence.
# Required for `pnpm db:push` and production persistence.
ASTRO_DB_REMOTE_URL=
ASTRO_DB_APP_TOKEN=
