---
import Layout from "../../layouts/Layout.astro";
import LoaderAnimation from "../../components/LoaderAnimation.astro";
import BackLink from "../../components/BackLink.astro";
import LangToggle from "../../components/Blog/LangToggle.astro";
import PostRow from "../../components/Blog/PostRow.astro";
import { getPublishedPosts } from "../../lib/blog";
import { SITE } from "../../site-config";

const posts = await getPublishedPosts();
---

<LoaderAnimation />

<Layout
  description={`Engineering notes on Big Data, distributed systems, high-performance backend, cloud-native microservices, and AI agent architecture by ${SITE.author.fullNameVi} (${SITE.author.shortName}), Software Engineer @ ${SITE.author.companyVi}.`}
  title={`${SITE.author.fullNameVi} (${SITE.author.shortName}) — Engineering Blog`}
  keywords={["Do Quoc Viet blog", "vietdoo blog", "Do Quoc Viet engineering notes", "Handover Architecture", "AI Agent Architecture", "Big Data Vietnam"]}
>
  <main
    class="w-full min-h-screen flex flex-col justify-start items-start max-w-3xl mx-auto px-3.5 sm:px-8 py-6 sm:py-8"
  >
    <div class="w-full mb-6">
      <h1 class="text-3xl sm:text-4xl font-bold text-neutral-100 tracking-tight">Posts</h1>
    </div>

    {
      posts.length === 0 ? (
        <p class="text-neutral-400 text-sm">
          Nothing to say right now... check back later (or don't, no pressure
          🙃)
        </p>
      ) : (
        <ul class="w-full p-0 m-0 space-y-2.5" data-post-list>
          {posts.map((post) => (
            <PostRow post={post} hidden={post.data.lang !== "en"} />
          ))}
        </ul>
      )
    }
    <p class="text-neutral-400 text-xs mt-6" data-empty-lang hidden>
      No posts in this language yet.
    </p>
  </main>
</Layout>

<script is:inline>
  (function () {
    try {
      var stored = localStorage.getItem("portfolio:blog-lang");
      var lang = stored === "vi" ? "vi" : "en";
      var params = new URLSearchParams(window.location.search);
      var q = (params.get("q") || "").toLowerCase().trim();
      var rows = document.querySelectorAll("[data-post-lang]");
      var visible = 0;
      rows.forEach(function (row) {
        var langMatches = row.getAttribute("data-post-lang") === lang;
        var textMatches = !q || (row.getAttribute("data-search-text") || "").indexOf(q) !== -1;
        if (langMatches && textMatches) {
          row.removeAttribute("hidden");
          visible++;
        } else {
          row.setAttribute("hidden", "");
        }
      });
      var empty = document.querySelector("[data-empty-lang]");
      if (empty) {
        if (visible > 0 || rows.length === 0) {
          empty.setAttribute("hidden", "");
        } else {
          empty.removeAttribute("hidden");
          if (q) {
            empty.textContent = "No posts matching your search query.";
          }
        }
      }
      var options = document.querySelectorAll("[data-lang-toggle] [data-lang-option]");
      options.forEach(function (option) {
        var isCurrent = option.getAttribute("data-lang-option") === lang;
        option.setAttribute("data-active", isCurrent ? "true" : "false");
        option.setAttribute("aria-pressed", String(isCurrent));
        if (isCurrent) {
          option.setAttribute("aria-current", "page");
        } else {
          option.removeAttribute("aria-current");
        }
      });
    } catch (e) {}
  })();
</script>

<script>
  import { BLOG_LANG_KEY } from "../../lib/blog-lang";

  let currentLang = "en";
  let currentQuery = "";

  function applyFilters() {
    const rows = document.querySelectorAll<HTMLElement>("[data-post-lang]");
    let visible = 0;
    const q = currentQuery.toLowerCase().trim();

    rows.forEach((row) => {
      const matchesLang = row.dataset.postLang === currentLang;
      const matchesText = !q || (row.dataset.searchText || "").includes(q);
      const isVisible = matchesLang && matchesText;

      row.hidden = !isVisible;
      if (isVisible) visible += 1;
    });

    const empty = document.querySelector<HTMLElement>("[data-empty-lang]");
    if (empty) {
      empty.hidden = visible > 0 || rows.length === 0;
      if (q && visible === 0) {
        empty.textContent = "No posts matching your search query.";
      } else {
        empty.textContent = "No posts in this language yet.";
      }
    }

    document
      .querySelectorAll<HTMLElement>("[data-lang-toggle] [data-lang-option]")
      .forEach((option) => {
        const isCurrent = option.dataset.langOption === currentLang;
        option.dataset.active = isCurrent ? "true" : "false";
        option.setAttribute("aria-pressed", String(isCurrent));
        if (isCurrent) {
          option.setAttribute("aria-current", "page");
        } else {
          option.removeAttribute("aria-current");
        }
      });
  }

  function setupBlogFilters() {
    if (!document.querySelector("[data-post-list]")) return;

    const stored = localStorage.getItem(BLOG_LANG_KEY);
    currentLang = stored === "vi" ? "vi" : "en";

    const params = new URLSearchParams(window.location.search);
    currentQuery = params.get("q") || "";

    applyFilters();

    document
      .querySelectorAll<HTMLElement>("[data-lang-toggle] [data-lang-option]")
      .forEach((option) => {
        option.addEventListener("click", () => {
          const lang = option.dataset.langOption;
          if (lang) {
            currentLang = lang;
            applyFilters();
          }
        });
      });

    window.addEventListener("header-search", (e: any) => {
      currentQuery = e.detail?.query || "";
      applyFilters();
    });

    window.addEventListener("blog-lang-change", (e: any) => {
      currentLang = e.detail?.lang || "en";
      applyFilters();
    });
  }

  document.addEventListener("astro:page-load", setupBlogFilters);
  setupBlogFilters();
</script>

