---
import Layout from "../layouts/Layout.astro";
import LoaderAnimation from "../components/LoaderAnimation.astro";
import { SITE } from "../site-config";
import { Icon } from "astro-icon/components";

const resumeData = {
  header: {
    name: SITE.author.fullNameVi,
    nameEn: SITE.author.fullName,
    title: SITE.author.jobTitleFull,
    location: "Ho Chi Minh City, Vietnam (GMT+7)",
    email: SITE.links.email,
    github: SITE.links.github,
    linkedin: SITE.links.linkedin,
    website: SITE.site.url,
  },
  summary:
    "Data & Software Engineer with 3+ YOE specializing in high-performance backend systems, Big Data pipelines, cloud-native microservices, and AI agent architectures. Currently engineering the National Public Service Portal at VNPT, serving millions of citizens nationwide.",
  experience: [
    {
      period: "Dec 2024 — Present",
      role: "Software Engineer",
      company: "VNPT Group (Vietnam Posts and Telecommunications Group)",
      location: "Ho Chi Minh City, Vietnam",
      highlights: [
        "Architecting and optimizing high-throughput microservices for the Vietnam National Public Service Portal (Cổng Dịch vụ công Quốc gia).",
        "Ensuring system resilience, ultra-low latency, and high availability for mission-critical e-Government public administrative procedures.",
        "Engineering scalable REST microservices with Spring Boot, FastAPI, Redis, Apache Kafka, Docker, and Kubernetes.",
      ],
    },
    {
      period: "2024 — Present",
      role: "Founder & Lead Architect",
      company: "VNDO SaaS Platform",
      location: "Ho Chi Minh City, Vietnam",
      highlights: [
        "Founded VNDO (vndo.vn), a modern website-building and web ecosystem platform operating across 5 global points of presence (Hanoi, HCMC, Da Nang, Singapore, US).",
        "Built global multi-region edge deployment pipeline with <50ms response latency and targeting 99.99% uptime.",
        "Developed specialized sub-products including Public Service Lookups (hosodichvucong.online), Document Management (vanban.hosodichvucong.online), Kiosk CHCC (kiosk-hcc.hosodichvucong.online), and Social Trend Analytics (diemtrend.vietdoo.site).",
      ],
    },
    {
      period: "Mar 2023 — Feb 2024",
      role: "Data Engineer",
      company: "Embery Digital Agency",
      location: "Melbourne, Australia / Remote",
      highlights: [
        "Engineered automated, high-volume ETL data workflows ingesting structured and unstructured data from hundreds of disparate client sources.",
        "Incorporated machine learning models into data processing pipelines to automate image analysis and computer vision scoring.",
        "Exposed custom trend-analysis APIs and analytics dashboards for digital intelligence platforms.",
      ],
    },
  ],
  education: [
    {
      period: "2020 — 2024",
      institution: "VNU-HCM University of Science (ĐH Khoa Học Tự Nhiên - ĐHQG TP.HCM)",
      degree: "Bachelor of Science in Data Science",
      details: "Graduated with High Honors (GPA: 3.5/4.0). Grounded in competitive programming, mathematical modeling, algorithm optimization, and distributed data systems.",
    },
  ],
  certifications: [
    { title: "Claude Code in Action", issuer: "Anthropic", date: "May 2026", id: "uxun2k7buozd" },
    { title: "Data Engineering, Big Data, & ML on GCP", issuer: "Google", date: "Sep 2022", id: "EZMZERSNG6UB" },
    { title: "IBM Data Engineering Professional Certificate", issuer: "IBM", date: "Aug 2022", id: "948G3Z9KNZ7C" },
    { title: "SQL (Advanced)", issuer: "HackerRank", date: "Mar 2022", id: "f586e92927c5" },
    { title: "Problem Solving (Intermediate)", issuer: "HackerRank", date: "Nov 2021", id: "ad708e2017db" },
    { title: "Neural Networks and Deep Learning", issuer: "DeepLearning.AI", date: "Sep 2021", id: "CR8RHMS5LT5P" },
    { title: "Machine Learning with Python", issuer: "IBM", date: "Aug 2021", id: "6RGVKBUBRC9D" },
    { title: "Google Cloud Certified", issuer: "Google", date: "Mar 2021", id: "Verified" },
  ],
  skills: [
    { category: "Languages", items: ["Python", "C++", "TypeScript", "SQL", "Shell", "Ruby", "HTML/CSS"] },
    { category: "Backend & Web", items: ["Spring Boot", "FastAPI", "Flask", "Next.js", "SolidJS", "Astro", "Ruby on Rails"] },
    { category: "Big Data & Streaming", items: ["Apache Spark", "Spark Streaming", "Apache Kafka", "Hadoop HDFS", "Apache Superset", "Redshift"] },
    { category: "Databases & Caching", items: ["PostgreSQL", "Redis", "MongoDB", "SQLite3"] },
    { category: "Cloud & DevOps", items: ["Docker", "Kubernetes", "Linux (Ubuntu/Debian)", "Microservices", "CI/CD", "Vercel"] },
    { category: "AI & Systems Architecture", items: ["AI Agent Architecture", "Handover Architecture", "LLM Fine-tuning", "OpenCV", "Z3 SMT Solver"] },
  ],
  projects: [
    {
      name: "Vietnam National Public Service Portal",
      tech: "Spring Boot, FastAPI, Microservices, Redis, Kafka, Kubernetes",
      desc: "National digital transformation project providing public administrative services to millions of citizens.",
    },
    {
      name: "VNDO SaaS Platform & Ecosystem",
      tech: "Next.js, Multi-region Edge CDN, SolidJS, PostgreSQL",
      desc: "Website-building SaaS powering Hồ Sơ Dịch Vụ Công, Văn Bản HCC, Kiosk CHCC, and Điểm Trend.",
    },
    {
      name: "HCMC Houses Analysis Pipeline",
      tech: "HDFS, Apache Spark, Redshift, Apache Superset",
      desc: "Big Data analysis pipeline extracting and transforming 200k+ real estate listings for BI visualization.",
    },
    {
      name: "Binance Real-Time Volume Streaming",
      tech: "Apache Kafka, Spark Streaming, WebSockets",
      desc: "Live stream ingestion and real-time volume metrics calculation for Binance cryptocurrency pairs.",
    },
    {
      name: "AI Agent Handover Architecture",
      tech: "Agentic Workflows, Handover Ledger, Claude / Codex",
      desc: "Standardized repo-level continuity pattern preventing context loss across multi-agent handovers.",
    },
  ],
};
---

<LoaderAnimation />

<Layout
  title={`${SITE.author.fullNameVi} — Resume / Curriculum Vitae`}
  description={`Official Resume and Curriculum Vitae of ${SITE.author.fullNameVi}, Software Engineer @ VNPT & Founder @ VNDO.`}
  hideSoundToggle={true}
>
  <main class="w-full max-w-4xl mx-auto px-4 sm:px-6 py-6 sm:py-10 text-darkslate-100 print:text-black print:bg-white print:max-w-none print:px-0 print:py-0">
    
    <!-- Top Action Bar (Print / PDF) -->
    <div class="flex items-center justify-between mb-4 print:hidden">
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-xs font-mono font-medium">
        <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
        <span>Verified Engineer CV</span>
      </div>

      <button
        onclick="window.print()"
        type="button"
        class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-lg bg-darkslate-800 hover:bg-darkslate-700 border border-darkslate-600/80 hover:border-primary-500/60 text-white text-xs font-mono font-medium transition-all shadow-sm cursor-pointer active:scale-95"
        title="Print or Save as PDF"
      >
        <Icon name="ri:printer-line" class="w-4 h-4 text-primary-400" />
        <span>Print / Save PDF</span>
      </button>
    </div>

    <!-- Resume Document Sheet -->
    <div class="bg-darkslate-800/95 border border-darkslate-600/80 rounded-2xl p-6 sm:p-10 shadow-2xl backdrop-blur-md print:bg-transparent print:border-none print:p-0 print:shadow-none">
      
      <!-- Candidate Header -->
      <header class="border-b border-darkslate-700/80 pb-6 mb-8 print:border-gray-300">
        <div class="flex flex-col md:flex-row md:items-start justify-between gap-6">
          <div>
            <h1 class="text-2xl sm:text-3xl font-extrabold tracking-tight text-white print:text-black">{resumeData.header.name}</h1>
            <p class="text-primary-400 font-semibold text-base sm:text-lg mt-1 print:text-gray-800">{resumeData.header.title}</p>
            <div class="flex items-center gap-2 text-xs sm:text-sm text-darkslate-200 mt-2.5 print:text-gray-700">
              <Icon name="ri:map-pin-line" class="w-4 h-4 text-primary-400 shrink-0 print:hidden" />
              <span class="font-medium">{resumeData.header.location}</span>
            </div>
          </div>

          <div class="flex flex-wrap md:flex-col gap-2 text-xs text-darkslate-200 print:text-gray-800 shrink-0">
            <a href={`mailto:${resumeData.header.email}`} class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-darkslate-900/80 hover:bg-darkslate-700/80 border border-darkslate-700/80 hover:border-primary-500/60 text-darkslate-200 hover:text-white transition-all">
              <Icon name="ri:mail-line" class="w-4 h-4 text-primary-400 shrink-0 print:hidden" />
              <span class="truncate font-mono">{resumeData.header.email}</span>
            </a>
            <a href={resumeData.header.github} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-darkslate-900/80 hover:bg-darkslate-700/80 border border-darkslate-700/80 hover:border-primary-500/60 text-darkslate-200 hover:text-white transition-all">
              <Icon name="ri:github-fill" class="w-4 h-4 text-primary-400 shrink-0 print:hidden" />
              <span class="truncate font-mono">{resumeData.header.github.replace('https://', '')}</span>
            </a>
            <a href={resumeData.header.linkedin} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-darkslate-900/80 hover:bg-darkslate-700/80 border border-darkslate-700/80 hover:border-primary-500/60 text-darkslate-200 hover:text-white transition-all">
              <Icon name="ri:linkedin-box-fill" class="w-4 h-4 text-primary-400 shrink-0 print:hidden" />
              <span class="truncate font-mono">{resumeData.header.linkedin.replace('https://www.', '').replace('https://', '')}</span>
            </a>
            <a href={resumeData.header.website} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 px-3 py-1.5 rounded-lg bg-darkslate-900/80 hover:bg-darkslate-700/80 border border-darkslate-700/80 hover:border-primary-500/60 text-darkslate-200 hover:text-white transition-all">
              <Icon name="ri:global-line" class="w-4 h-4 text-primary-400 shrink-0 print:hidden" />
              <span class="truncate font-mono">{resumeData.header.website.replace('https://', '')}</span>
            </a>
          </div>
        </div>
      </header>

      <!-- Executive Summary -->
      <section class="mb-8">
        <h2 class="text-xs font-mono font-bold text-primary-400 uppercase tracking-wider mb-3 flex items-center gap-2 border-b border-darkslate-700/80 pb-2 print:text-black print:border-gray-300">
          <span class="text-darkslate-400 print:hidden">//</span> EXECUTIVE SUMMARY
        </h2>
        <div class="p-4 sm:p-5 rounded-xl bg-darkslate-900/80 border-l-4 border-primary-500 border-y border-r border-darkslate-700/80 text-darkslate-100 text-xs sm:text-sm leading-relaxed shadow-sm print:bg-transparent print:border-l-2 print:border-gray-400 print:p-2 print:text-black">
          {resumeData.summary}
        </div>
      </section>

      <!-- Work Experience -->
      <section class="mb-8">
        <h2 class="text-xs font-mono font-bold text-primary-400 uppercase tracking-wider mb-5 flex items-center gap-2 border-b border-darkslate-700/80 pb-2 print:text-black print:border-gray-300">
          <span class="text-darkslate-400 print:hidden">//</span> PROFESSIONAL EXPERIENCE
        </h2>
        <div class="space-y-6">
          {resumeData.experience.map((exp) => (
            <div class="relative pl-5 border-l-2 border-primary-500/40 print:border-gray-300">
              <div class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-primary-500 border-2 border-darkslate-800 shadow-sm print:bg-gray-700 print:border-white"></div>
              <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-1 mb-2">
                <div>
                  <h3 class="text-base sm:text-lg font-bold text-white print:text-black inline">
                    {exp.role}
                  </h3>
                  <span class="text-primary-400 font-semibold text-sm sm:text-base print:text-gray-800 ml-1.5">
                    @ {exp.company}
                  </span>
                </div>
                <span class="text-xs font-mono font-semibold text-primary-300 bg-primary-950/60 border border-primary-500/40 px-2.5 py-1 rounded-md shrink-0 w-fit print:bg-gray-100 print:text-black print:border-gray-300">
                  {exp.period}
                </span>
              </div>
              <p class="text-xs text-darkslate-300 font-medium mb-2 print:text-gray-600">{exp.location}</p>
              <ul class="space-y-2 text-xs sm:text-sm text-darkslate-200 print:text-gray-800">
                {exp.highlights.map((h) => (
                  <li class="flex items-start gap-2.5">
                    <span class="text-primary-400 font-bold select-none mt-0.5 print:text-gray-600">›</span>
                    <span class="leading-relaxed">{h}</span>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>
      </section>

      <!-- Technical Stack Matrix -->
      <section class="mb-8">
        <h2 class="text-xs font-mono font-bold text-primary-400 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-darkslate-700/80 pb-2 print:text-black print:border-gray-300">
          <span class="text-darkslate-400 print:hidden">//</span> TECHNICAL STACK & CORE SKILLS
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {resumeData.skills.map((group) => (
            <div class="bg-darkslate-900/80 border border-darkslate-700/80 rounded-xl p-4 shadow-sm print:bg-transparent print:border-gray-300">
              <h3 class="text-xs font-mono font-bold text-white uppercase tracking-wider mb-2.5 flex items-center gap-1.5 print:text-black">
                <span class="w-1.5 h-1.5 rounded-full bg-primary-400 print:bg-gray-600"></span>
                {group.category}
              </h3>
              <div class="flex flex-wrap gap-1.5">
                {group.items.map((item) => (
                  <span class="px-2.5 py-1 bg-darkslate-800 border border-darkslate-600/80 text-darkslate-100 rounded-md text-xs font-mono hover:border-primary-500/60 hover:text-primary-300 transition-all shadow-xs print:bg-gray-100 print:text-black print:border-gray-300">
                    {item}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Key Engineering Projects -->
      <section class="mb-8">
        <h2 class="text-xs font-mono font-bold text-primary-400 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-darkslate-700/80 pb-2 print:text-black print:border-gray-300">
          <span class="text-darkslate-400 print:hidden">//</span> KEY ENGINEERING PROJECTS
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {resumeData.projects.map((proj) => (
            <div class="bg-darkslate-900/80 border border-darkslate-700/80 hover:border-primary-500/50 rounded-xl p-4.5 transition-all shadow-sm group print:bg-transparent print:border-gray-300">
              <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-primary-300 transition-colors print:text-black">{proj.name}</h3>
              <div class="mt-1.5 mb-2.5">
                <span class="text-[11px] font-mono font-medium text-primary-300 bg-primary-950/40 border border-primary-500/20 px-2 py-0.5 rounded inline-block print:bg-gray-100 print:text-black print:border-gray-300">
                  {proj.tech}
                </span>
              </div>
              <p class="text-xs text-darkslate-200 print:text-gray-800 leading-relaxed">{proj.desc}</p>
            </div>
          ))}
        </div>
      </section>

      <!-- Verified Certifications & Credentials -->
      <section class="mb-8">
        <h2 class="text-xs font-mono font-bold text-primary-400 uppercase tracking-wider mb-4 flex items-center gap-2 border-b border-darkslate-700/80 pb-2 print:text-black print:border-gray-300">
          <span class="text-darkslate-400 print:hidden">//</span> CERTIFICATIONS & CREDENTIALS
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3.5">
          {resumeData.certifications.map((cert) => (
            <div class="bg-darkslate-900/80 border border-darkslate-700/80 hover:border-primary-500/50 rounded-xl p-4 flex flex-col justify-between transition-all shadow-sm print:bg-transparent print:border-gray-300">
              <div>
                <h3 class="text-xs sm:text-sm font-bold text-white flex items-center gap-1.5 print:text-black">
                  <Icon name="ri:checkbox-circle-fill" class="w-3.5 h-3.5 text-emerald-400 shrink-0 print:hidden" />
                  <span>{cert.title}</span>
                </h3>
                <div class="flex items-center justify-between mt-1.5 text-xs text-darkslate-200">
                  <span class="font-medium text-darkslate-100">{cert.issuer}</span>
                  <span class="font-mono text-primary-300 bg-primary-950/40 border border-primary-500/30 px-2 py-0.5 rounded text-[11px] print:bg-gray-100 print:text-black print:border-gray-300">{cert.date}</span>
                </div>
              </div>
              <div class="mt-3 pt-2 border-t border-darkslate-800 print:border-gray-200">
                <span class="text-[11px] font-mono text-darkslate-200 bg-darkslate-800 border border-darkslate-700/80 px-2.5 py-1 rounded-md inline-flex items-center gap-1.5 select-all print:bg-gray-100 print:text-black print:border-gray-300">
                  <span class="text-darkslate-400 font-normal">ID:</span>
                  <span class="font-semibold text-white print:text-black">{cert.id}</span>
                </span>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Education -->
      <section>
        <h2 class="text-xs font-mono font-bold text-primary-400 uppercase tracking-wider mb-3 flex items-center gap-2 border-b border-darkslate-700/80 pb-2 print:text-black print:border-gray-300">
          <span class="text-darkslate-400 print:hidden">//</span> EDUCATION
        </h2>
        {resumeData.education.map((edu) => (
          <div class="bg-darkslate-900/80 border border-darkslate-700/80 rounded-xl p-5 shadow-sm print:bg-transparent print:border-gray-300">
            <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-2">
              <div>
                <h3 class="text-base font-bold text-white print:text-black flex items-center gap-2">
                  <span>{edu.degree}</span>
                  <span class="px-2 py-0.5 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-[11px] rounded-full font-mono font-medium print:bg-gray-100 print:text-black print:border-gray-300">GPA: 3.5/4.0</span>
                </h3>
                <p class="text-xs sm:text-sm text-darkslate-200 font-medium mt-1 print:text-gray-700">{edu.institution}</p>
              </div>
              <span class="text-xs font-mono font-semibold text-primary-300 bg-primary-950/60 border border-primary-500/40 px-2.5 py-1 rounded-md shrink-0 w-fit print:bg-gray-100 print:text-black print:border-gray-300">{edu.period}</span>
            </div>
            <div class="mt-3.5 p-3 rounded-lg bg-darkslate-800/60 border border-darkslate-700/60 text-xs sm:text-sm text-darkslate-200 leading-relaxed print:bg-gray-50 print:border-gray-200 print:text-black">
              {edu.details}
            </div>
          </div>
        ))}
      </section>

    </div>
  </main>
</Layout>


