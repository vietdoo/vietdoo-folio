---
interface Props {
  title?: string;
  body?: string;
}

const { title, body } = Astro.props;
---

<>
  {title && <h2 class="min-w-0 max-w-full break-words text-base sm:text-lg md:text-xl font-bold leading-tight m-0 z-20">{title}</h2>}
  {body && <p class="m-0 font-light text-sm md:text-base flex flex-col">{body}</p>}
  <slot />
</>
