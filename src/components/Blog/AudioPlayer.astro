---
import type { BlogLang } from "../../lib/blog-lang";

type Props = {
  lang: BlogLang;
  targetId: string;
};

const { lang, targetId } = Astro.props;
const isVietnamese = lang === "vi";
const title = isVietnamese ? "Nghe bài viết" : "Listen to article";
const readyLabel = isVietnamese ? "Sẵn sàng" : "Ready";
const stopLabel = isVietnamese ? "Dừng" : "Stop";
---

<section
  class="tts-player"
  data-tts-player
  data-tts-lang={lang}
  data-tts-target={targetId}
  aria-label={title}
>
  <span class="tts-player__icon" aria-hidden="true">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8">
      <path d="M4 10v4h3l4 3V7l-4 3H4Z" stroke-linejoin="round" />
      <path d="M15 9.5a4 4 0 0 1 0 5M17.5 7a7.5 7.5 0 0 1 0 10" stroke-linecap="round" />
    </svg>
  </span>

  <span class="tts-player__title">{title}</span>

  <div class="tts-player__controls">
    <button
      type="button"
      class="tts-player__play"
      data-tts-toggle
      aria-label={isVietnamese ? "Đọc bài viết" : "Read article"}
    >
      <svg data-tts-icon-play viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <path d="M8 5.7c0-1.17 1.28-1.9 2.29-1.3l8.36 5.02a1.82 1.82 0 0 1 0 3.13l-8.36 5.02A1.52 1.52 0 0 1 8 16.27V5.7Z" />
      </svg>
      <svg data-tts-icon-pause viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" style="display:none">
        <path d="M7 5.5A1.5 1.5 0 0 1 8.5 4h1A1.5 1.5 0 0 1 11 5.5v13A1.5 1.5 0 0 1 9.5 20h-1A1.5 1.5 0 0 1 7 18.5v-13ZM13 5.5A1.5 1.5 0 0 1 14.5 4h1A1.5 1.5 0 0 1 17 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5v-13Z" />
      </svg>
    </button>

    <button type="button" class="tts-player__stop" data-tts-stop aria-label={stopLabel}>
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
        <rect x="6" y="6" width="12" height="12" rx="1.5" />
      </svg>
    </button>
  </div>

  <span class="tts-player__status" aria-live="polite" data-tts-status>{readyLabel}</span>
  <span class="tts-player__time" data-tts-time aria-label={isVietnamese ? "Tiến độ" : "Progress"}></span>

  <div
    class="tts-player__progress"
    data-tts-progress
    role="progressbar"
    aria-label={isVietnamese ? "Tiến độ đọc" : "Narration progress"}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span data-tts-progress-bar></span>
  </div>
</section>

<style>
  .tts-player {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3.1rem;
    margin-top: 0.75rem;
    padding: 0.55rem 0.65rem;
    border: 1px solid rgb(64 64 64 / 0.72);
    border-radius: 0.75rem;
    background: rgb(23 23 23 / 0.62);
    color: rgb(229 229 229);
    transition: border-color 160ms ease, background 160ms ease;
  }

  .tts-player:hover {
    border-color: rgb(115 115 115 / 0.9);
    background: rgb(38 38 38 / 0.68);
  }

  .tts-player[hidden] { display: none; }
  .tts-player[data-tts-unavailable="true"] { opacity: 0.72; }
  .tts-player__icon { display: grid; width: 1.8rem; height: 1.8rem; flex: 0 0 auto; place-items: center; border-radius: 0.5rem; color: rgb(212 212 212); background: rgb(64 64 64 / 0.48); }
  .tts-player__icon svg { width: 1rem; height: 1rem; }
  .tts-player__title { min-width: 0; color: rgb(245 245 245); font-size: 0.78rem; font-weight: 600; white-space: nowrap; }
  .tts-player__controls { display: flex; align-items: center; gap: 0.35rem; margin-left: auto; }
  .tts-player__play, .tts-player__stop { display: inline-grid; place-items: center; border: 1px solid rgb(82 82 82 / 0.9); color: rgb(229 229 229); background: rgb(38 38 38 / 0.78); cursor: pointer; transition: transform 160ms ease, border-color 160ms ease, background 160ms ease, color 160ms ease; }
  .tts-player__play:hover, .tts-player__stop:hover { border-color: rgb(163 163 163); color: white; background: rgb(64 64 64 / 0.86); }
  .tts-player__play:active, .tts-player__stop:active { transform: scale(0.96); }
  .tts-player__play:focus-visible, .tts-player__stop:focus-visible { outline: 2px solid rgb(212 212 212); outline-offset: 2px; }
  .tts-player__play { width: 2rem; height: 2rem; border-radius: 999px; color: rgb(23 23 23); background: rgb(245 245 245); border-color: rgb(245 245 245); }
  .tts-player__play:hover { color: rgb(23 23 23); background: white; border-color: white; }
  .tts-player__play svg { width: 0.82rem; height: 0.82rem; }
  .tts-player__stop { width: 1.75rem; height: 1.75rem; border-radius: 0.5rem; }
  .tts-player__stop svg { width: 0.7rem; height: 0.7rem; }
  .tts-player__status { color: rgb(163 163 163); font-size: 0.68rem; white-space: nowrap; }
  .tts-player__time { min-width: 2.2rem; color: rgb(115 115 115); font-size: 0.65rem; font-variant-numeric: tabular-nums; text-align: right; white-space: nowrap; }
  .tts-player__progress { position: absolute; right: 0.65rem; bottom: 0.28rem; left: 0.65rem; height: 1px; overflow: hidden; border-radius: 999px; background: rgb(115 115 115 / 0.28); }
  .tts-player__progress span { display: block; width: 0; height: 100%; border-radius: inherit; background: rgb(245 245 245); transition: width 160ms linear; }
  button:disabled { cursor: not-allowed; opacity: 0.55; }

  @media (max-width: 480px) {
    .tts-player { gap: 0.5rem; }
    .tts-player__title { font-size: 0.72rem; }
    .tts-player__status { display: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .tts-player, .tts-player__play, .tts-player__stop, .tts-player__progress span { transition: none; }
  }
</style>
