---
import type { BlogLang } from "../../lib/blog-lang";

type Props = {
  lang: BlogLang;
  targetId: string;
};

const { lang, targetId } = Astro.props;
const isVietnamese = lang === "vi";
const title = isVietnamese ? "Nghe bài viết" : "Listen to article";
const readyLabel = isVietnamese ? "Sẵn sàng đọc" : "Ready to read";
const progressLabel = isVietnamese ? "Tiến độ đọc" : "Narration progress";
---

<section
  class="tts-player"
  data-tts-player
  data-tts-lang={lang}
  data-tts-target={targetId}
  aria-label={title}
>
  <div class="tts-player__identity">
    <span class="tts-player__icon" aria-hidden="true">
      <svg
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
      >
        <path d="M4 10v4h3l4 3V7l-4 3H4Z" stroke-linejoin="round"></path>
        <path
          d="M15 9.5a4 4 0 0 1 0 5M17.5 7a7.5 7.5 0 0 1 0 10"
          stroke-linecap="round"></path>
      </svg>
    </span>
    <p class="tts-player__title">{title}</p>
  </div>

  <button
    type="button"
    class="tts-player__play"
    data-tts-toggle
    aria-label={isVietnamese ? "Đọc bài viết" : "Read article"}
  >
    <svg
      data-tts-icon-play
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
    >
      <path
        d="M8 5.7c0-1.17 1.28-1.9 2.29-1.3l8.36 5.02a1.82 1.82 0 0 1 0 3.13l-8.36 5.02A1.52 1.52 0 0 1 8 16.27V5.7Z"
      ></path>
    </svg>
    <svg
      data-tts-icon-pause
      viewBox="0 0 24 24"
      fill="currentColor"
      aria-hidden="true"
      style="display:none"
    >
      <path
        d="M7 5.5A1.5 1.5 0 0 1 8.5 4h1A1.5 1.5 0 0 1 11 5.5v13A1.5 1.5 0 0 1 9.5 20h-1A1.5 1.5 0 0 1 7 18.5v-13ZM13 5.5A1.5 1.5 0 0 1 14.5 4h1A1.5 1.5 0 0 1 17 5.5v13a1.5 1.5 0 0 1-1.5 1.5h-1a1.5 1.5 0 0 1-1.5-1.5v-13Z"
      ></path>
    </svg>
  </button>

  <div class="sr-only" data-tts-status aria-live="polite">{readyLabel}</div>
  <div
    class="tts-player__progress"
    data-tts-progress
    role="progressbar"
    aria-label={progressLabel}
    aria-valuemin="0"
    aria-valuemax="100"
    aria-valuenow="0"
  >
    <span data-tts-progress-bar></span>
  </div>
</section>

<style>
  .tts-player {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.75rem;
    padding: 0.82rem 1rem 0.95rem;
    border-top: 1px solid rgb(64 64 64 / 0.72);
    color: rgb(229 229 229);
  }

  .tts-player[hidden] {
    display: none;
  }

  .tts-player[data-tts-unavailable="true"] {
    opacity: 0.7;
  }

  .tts-player__identity {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.6rem;
  }

  .tts-player__icon {
    display: grid;
    width: 1.55rem;
    height: 1.55rem;
    flex: 0 0 auto;
    place-items: center;
    border: 1px solid rgb(82 82 82);
    border-radius: 999px;
    color: rgb(163 163 163);
  }

  .tts-player__icon svg {
    width: 0.82rem;
    height: 0.82rem;
  }

  .tts-player__title {
    margin: 0;
    color: rgb(229 229 229);
    font-size: 0.82rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .tts-player__play {
    display: inline-grid;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgb(115 115 115);
    border-radius: 999px;
    color: rgb(229 229 229);
    background: transparent;
    cursor: pointer;
    transition:
      background 160ms ease-out,
      border-color 160ms ease-out,
      color 160ms ease-out,
      transform 160ms ease-out;
  }

  .tts-player__play:hover {
    border-color: rgb(245 245 245);
    color: rgb(23 23 23);
    background: rgb(245 245 245);
  }

  .tts-player__play:active {
    transform: scale(0.96);
  }

  .tts-player__play:focus-visible {
    outline: 2px solid rgb(245 245 245);
    outline-offset: 2px;
  }

  .tts-player__play svg {
    width: 0.78rem;
    height: 0.78rem;
  }

  .tts-player__progress {
    position: absolute;
    right: 1rem;
    bottom: 0.38rem;
    left: 1rem;
    height: 1px;
    overflow: hidden;
    border-radius: 999px;
    background: rgb(64 64 64 / 0.75);
  }

  .tts-player__progress span {
    display: block;
    width: 0;
    height: 100%;
    border-radius: inherit;
    background: rgb(229 229 229);
    transition: width 160ms linear;
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.5;
  }

  @media (prefers-reduced-motion: reduce) {
    .tts-player__play,
    .tts-player__progress span {
      transition: none;
    }
  }
</style>
