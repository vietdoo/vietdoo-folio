<script is:inline>
  (() => {
    const copy = {
      en: "Article summary video",
      vi: "Video tóm tắt bài viết",
    };

    function toPath(value) {
      if (!value) return "";
      try {
        return new URL(value, window.location.href).pathname;
      } catch {
        return value;
      }
    }

    function removeDuplicateHero(article, video, figure) {
      const firstImage = article.querySelector("img");
      const poster = video.getAttribute("poster");
      if (!firstImage || !poster) return;

      const imagePath = toPath(
        firstImage.getAttribute("src") || firstImage.currentSrc,
      );
      if (!imagePath || imagePath !== toPath(poster)) return;

      const imageBlock = firstImage.closest("p, figure, picture") || firstImage;
      if (imageBlock !== figure && !imageBlock.closest(".blog-video-card")) {
        imageBlock.remove();
      }
    }

    function separateFollowingVideo(article, figure) {
      if (
        figure.previousElementSibling?.classList.contains("blog-video-card")
      ) {
        const firstContentBlock = Array.from(article.children).find(
          (element) =>
            !element.classList.contains("blog-video-card") &&
            ["P", "H2", "H3", "BLOCKQUOTE"].includes(element.tagName),
        );
        if (firstContentBlock) {
          firstContentBlock.after(figure);
        }
      }
    }

    function enhanceBlogVideos() {
      document
        .querySelectorAll("article[data-tts-content]")
        .forEach((article) => {
          const articleLanguage =
            article
              .closest("[data-blog-language]")
              ?.getAttribute("data-blog-language") ||
            document.documentElement.lang;
          const captionText = copy[articleLanguage === "vi" ? "vi" : "en"];
          const videos = Array.from(article.querySelectorAll("video"));

          videos.forEach((video, index) => {
            if (video.dataset.videoCardReady === "true") return;

            const existingFigure = video.closest("figure");
            const figure = existingFigure || document.createElement("figure");

            if (!existingFigure) {
              const parent = video.parentElement;
              if (
                parent?.tagName === "P" &&
                parent.children.length === 1 &&
                parent.firstElementChild === video
              ) {
                parent.replaceWith(figure);
              } else {
                video.parentNode?.insertBefore(figure, video);
              }
              figure.appendChild(video);
            }

            figure.classList.add("blog-video-card");
            figure.dataset.videoCard = "true";
            video.classList.add("blog-video-card__player");
            video.dataset.videoCardReady = "true";

            figure
              .querySelectorAll(".blog-video-card__header")
              .forEach((header) => header.remove());

            const caption = figure.querySelector("figcaption");
            if (caption) {
              caption.className = "blog-video-card__caption";
              caption.textContent = captionText;
            } else {
              const summary = document.createElement("figcaption");
              summary.className = "blog-video-card__caption";
              summary.textContent = captionText;
              figure.appendChild(summary);
            }

            if (index === 0) {
              removeDuplicateHero(article, video, figure);
              article.prepend(figure);
            } else {
              separateFollowingVideo(article, figure);
            }
          });
        });
    }

    document.addEventListener("astro:page-load", enhanceBlogVideos);
    document.addEventListener("DOMContentLoaded", enhanceBlogVideos, {
      once: true,
    });
    enhanceBlogVideos();
  })();
</script>

<style is:global>
  article[data-tts-content] .blog-video-card {
    display: block;
    margin: 0.25rem 0 2rem;
    overflow: hidden;
    border: 1px solid rgb(255 255 255 / 0.14);
    border-radius: 0.9rem;
    background: rgb(10 10 10);
    box-shadow: 0 12px 36px rgb(0 0 0 / 0.18);
  }

  article[data-tts-content] .blog-video-card__player {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgb(0 0 0);
    object-fit: cover;
  }

  article[data-tts-content] .blog-video-card__caption {
    margin: 0;
    padding: 0.7rem 0.85rem 0.78rem;
    border-top: 1px solid rgb(255 255 255 / 0.1);
    color: rgb(163 163 163);
    font-size: 0.75rem;
    line-height: 1.4;
  }

  article[data-tts-content] .blog-video-card:focus-within {
    border-color: rgb(255 255 255 / 0.38);
    box-shadow:
      0 0 0 3px rgb(255 255 255 / 0.08),
      0 12px 36px rgb(0 0 0 / 0.18);
  }

  @media (max-width: 640px) {
    article[data-tts-content] .blog-video-card {
      margin: 0 0 1.75rem;
      border-radius: 0.75rem;
    }

    article[data-tts-content] .blog-video-card__caption {
      padding: 0.65rem 0.75rem 0.72rem;
      font-size: 0.72rem;
    }
  }
</style>
