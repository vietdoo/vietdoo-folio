<script is:inline>
  (() => {
    const copy = {
      en: {
        label: "Article video",
        hint: "Watch the explanation in context",
        fallback: "Explainer video for this article",
      },
      vi: {
        label: "Video bài viết",
        hint: "Xem phần giải thích ngay trong bài",
        fallback: "Video giải thích nội dung bài viết",
      },
    };

    function enhanceBlogVideos() {
      const language = document.documentElement.lang === "vi" ? "vi" : "en";
      const labels = copy[language];

      document
        .querySelectorAll("article[data-tts-content]")
        .forEach((article) => {
          article.querySelectorAll("video").forEach((video) => {
            if (video.dataset.videoCardReady === "true") return;

            const existingFigure = video.closest("figure");
            const figure = existingFigure || document.createElement("figure");

            if (!existingFigure) {
              video.parentNode?.insertBefore(figure, video);
              figure.appendChild(video);
            }

            figure.classList.add("blog-video-card");
            figure.dataset.videoCard = "true";
            video.classList.add("blog-video-card__player");
            video.dataset.videoCardReady = "true";

            if (!figure.querySelector(".blog-video-card__header")) {
              const header = document.createElement("div");
              header.className = "blog-video-card__header";
              header.innerHTML = `
              <div class="blog-video-card__identity">
                <span class="blog-video-card__icon" aria-hidden="true">▶</span>
                <div>
                  <p class="blog-video-card__label">${labels.label}</p>
                  <p class="blog-video-card__hint">${labels.hint}</p>
                </div>
              </div>
              <span class="blog-video-card__badge">MP4</span>
            `;
              figure.insertBefore(header, video);
            }

            const caption = figure.querySelector("figcaption");
            if (caption) {
              caption.classList.add("blog-video-card__caption");
            } else {
              const fallbackCaption = document.createElement("figcaption");
              fallbackCaption.className = "blog-video-card__caption";
              fallbackCaption.textContent =
                video.getAttribute("aria-label") || labels.fallback;
              figure.appendChild(fallbackCaption);
            }
          });
        });
    }

    document.addEventListener("astro:page-load", enhanceBlogVideos);
    document.addEventListener("DOMContentLoaded", enhanceBlogVideos, {
      once: true,
    });
    enhanceBlogVideos();
  })();
</script>

<style is:global>
  article[data-tts-content] .blog-video-card {
    position: relative;
    display: block;
    margin: 2.5rem 0 3rem;
    overflow: hidden;
    border: 1px solid rgb(148 163 184 / 0.2);
    border-radius: 1.25rem;
    background:
      radial-gradient(
        circle at 100% 0%,
        rgb(245 158 11 / 0.08),
        transparent 32%
      ),
      linear-gradient(145deg, rgb(30 41 59 / 0.92), rgb(15 23 42 / 0.96));
    box-shadow: 0 24px 70px rgb(0 0 0 / 0.24);
  }

  article[data-tts-content] .blog-video-card__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 1rem;
    border-bottom: 1px solid rgb(148 163 184 / 0.14);
  }

  article[data-tts-content] .blog-video-card__identity {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 0.7rem;
  }

  article[data-tts-content] .blog-video-card__icon {
    display: grid;
    flex: 0 0 auto;
    width: 2rem;
    height: 2rem;
    place-items: center;
    border: 1px solid rgb(251 191 36 / 0.42);
    border-radius: 999px;
    background: rgb(245 158 11 / 0.16);
    color: rgb(253 230 138);
    font-size: 0.65rem;
  }

  article[data-tts-content] .blog-video-card__label,
  article[data-tts-content] .blog-video-card__hint {
    margin: 0;
  }

  article[data-tts-content] .blog-video-card__label {
    color: rgb(248 250 252);
    font-size: 0.82rem;
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  article[data-tts-content] .blog-video-card__hint {
    margin-top: 0.15rem;
    color: rgb(148 163 184);
    font-size: 0.72rem;
    line-height: 1.35;
  }

  article[data-tts-content] .blog-video-card__badge {
    flex: 0 0 auto;
    border: 1px solid rgb(148 163 184 / 0.2);
    border-radius: 999px;
    padding: 0.28rem 0.52rem;
    color: rgb(148 163 184);
    font-size: 0.62rem;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  article[data-tts-content] .blog-video-card__player {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    background: rgb(2 6 23);
    object-fit: cover;
  }

  article[data-tts-content] .blog-video-card__caption {
    margin: 0;
    padding: 0.8rem 1rem 0.95rem;
    border-top: 1px solid rgb(148 163 184 / 0.14);
    color: rgb(148 163 184);
    font-size: 0.82rem;
    line-height: 1.5;
  }

  article[data-tts-content] .blog-video-card:focus-within {
    border-color: rgb(251 191 36 / 0.58);
    box-shadow:
      0 0 0 3px rgb(245 158 11 / 0.12),
      0 24px 70px rgb(0 0 0 / 0.24);
  }

  @media (max-width: 640px) {
    article[data-tts-content] .blog-video-card {
      margin: 2rem -0.25rem 2.5rem;
      border-radius: 1rem;
    }

    article[data-tts-content] .blog-video-card__header {
      padding: 0.75rem 0.8rem;
    }

    article[data-tts-content] .blog-video-card__hint {
      max-width: 13rem;
    }

    article[data-tts-content] .blog-video-card__caption {
      padding: 0.72rem 0.8rem 0.85rem;
    }
  }
</style>
