---
import Card from "./Card/index.astro";
import { getPublishedPosts } from "../lib/blog";

const posts = await getPublishedPosts();

// Filter unique posts by translationKey to avoid language duplicates
const uniquePostsMap = new Map();
for (const post of posts) {
  const key = post.data.translationKey || post.id;
  if (!uniquePostsMap.has(key)) {
    uniquePostsMap.set(key, post);
  }
}
const allPosts = Array.from(uniquePostsMap.values());
const latestPost = allPosts[0];
const postCount = allPosts.length;

const formattedDate = latestPost?.data.pubDate
  ? new Date(latestPost.data.pubDate).toLocaleDateString("en-US", {
      month: "short",
      day: "numeric",
      year: "numeric",
    })
  : "";
---

<Card
  href="/blog"
  colSpan="md:col-span-1"
  rowSpan="md:row-span-2"
  padding="p-3.5 sm:p-4"
  arrowCorner={true}
>
  <div class="h-full flex flex-col justify-between gap-2 overflow-hidden">
    {/* Top Header Bar */}
    <div class="flex items-center gap-2 pr-6 flex-shrink-0">
      <h2 class="text-base font-bold m-0 text-white tracking-tight">
        Blog
      </h2>
      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-darkslate-600 text-white/80 border border-white/10 font-semibold">
        {postCount} POSTS
      </span>
    </div>

    {/* Crisp Featured Thumbnail Image Frame */}
    {latestPost?.data.image && (
      <div class="relative w-full h-20 sm:h-24 rounded-lg overflow-hidden border border-white/10 bg-darkslate-600 shadow-md group-hover:border-primary-500/40 transition-colors flex-shrink-0">
        <img
          src={latestPost.data.image}
          alt={latestPost.data.title}
          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500 ease-out"
          loading="lazy"
        />
        {/* Category Tag Badge */}
        <span class="absolute top-1.5 left-1.5 text-[9px] font-mono font-bold uppercase tracking-wider text-white bg-black/80 backdrop-blur-md px-2 py-0.5 rounded border border-white/20">
          {latestPost.data.category || "FEATURED"}
        </span>
      </div>
    )}

    {/* Article Info */}
    {latestPost && (
      <div class="flex-1 flex flex-col justify-between min-h-0 pt-0.5">
        <div>
          <span class="text-[10px] font-mono text-white/50 block mb-0.5 font-medium">
            {formattedDate}
          </span>
          <h3 class="text-xs sm:text-sm font-semibold text-white/95 group-hover:text-primary-400 transition-colors line-clamp-2 leading-snug">
            {latestPost.data.title}
          </h3>
        </div>

        <div class="pt-1 flex items-center justify-between text-[11px] font-mono text-white/60 group-hover:text-white transition-colors border-t border-white/10 mt-1">
          <span>Latest article</span>
          <span class="text-primary-400 group-hover:translate-x-1 transition-transform font-bold">&rarr;</span>
        </div>
      </div>
    )}
  </div>
</Card>

