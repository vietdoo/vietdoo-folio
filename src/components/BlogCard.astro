---
import Card from "./Card/index.astro";
import { getPublishedPosts } from "../lib/blog";

const posts = await getPublishedPosts();

// Filter unique posts by translationKey to avoid language duplicates
const uniquePostsMap = new Map();
for (const post of posts) {
  const key = post.data.translationKey || post.id;
  if (!uniquePostsMap.has(key) && post.data.image) {
    uniquePostsMap.set(key, post);
  }
}
const allPosts = Array.from(uniquePostsMap.values());
const featuredPosts = allPosts.slice(0, 5);
const recentListPosts = allPosts.slice(1, 4);
const postCount = uniquePostsMap.size;
---

<Card
  href="/blog"
  colSpan="md:col-span-1"
  rowSpan="md:row-span-4"
  padding="p-3.5 sm:p-4"
  arrowCorner={true}
>
  <div class="h-full flex flex-col justify-between gap-2.5 select-none">
    {/* Top Header Bar */}
    <div class="flex items-center gap-2 pr-6 flex-shrink-0">
      <h2 class="text-base font-bold m-0 text-white tracking-tight">
        Blog
      </h2>
      <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-darkslate-600 text-white/80 border border-white/10 font-semibold">
        {postCount} POSTS
      </span>
    </div>

    {/* Digital Magazine Billboard Showcase (Top Half) */}
    <div
      class="blog-billboard-container relative h-48 sm:h-52 w-full rounded-xl overflow-hidden border border-white/10 bg-darkslate-600 shadow-lg group-hover:border-darkslate-300/40 transition-colors flex-shrink-0"
      data-count={featuredPosts.length}
    >
      {featuredPosts.map((post, idx) => {
        const formattedDate = post.data.pubDate
          ? new Date(post.data.pubDate).toLocaleDateString("en-US", {
              month: "short",
              day: "numeric",
              year: "numeric",
            })
          : "";

        return (
          <div
            class:list={[
              "blog-slide absolute inset-0 transition-all duration-700 ease-in-out flex flex-col justify-between p-3.5",
              idx === 0 ? "opacity-100 z-10 scale-100" : "opacity-0 z-0 scale-95 pointer-events-none"
            ]}
            data-slide={idx}
          >
            {/* Cover Image Background */}
            <img
              src={post.data.image}
              alt={post.data.title}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700 ease-out"
              loading={idx === 0 ? "eager" : "lazy"}
            />

            {/* Gradient Overlay for Text Readability */}
            <div class="absolute inset-x-0 bottom-0 h-4/5 bg-gradient-to-t from-black/90 via-black/50 to-transparent pointer-events-none"></div>

            {/* Category Tag & Slide Dots */}
            <div class="relative z-10 flex items-center justify-between gap-1">
              <span class="text-[9px] font-mono font-bold uppercase tracking-wider text-white bg-black/70 backdrop-blur-md px-2 py-0.5 rounded border border-white/20">
                {post.data.category || "FEATURED"}
              </span>
              {/* Slide Indicators */}
              <div class="flex items-center gap-1 bg-black/50 backdrop-blur-md px-1.5 py-1 rounded-full border border-white/10">
                {featuredPosts.map((_, dotIdx) => (
                  <span
                    class:list={[
                      "blog-dot w-1.5 h-1.5 rounded-full transition-all duration-300",
                      dotIdx === idx ? "bg-primary-400 w-3" : "bg-white/40"
                    ]}
                  />
                ))}
              </div>
            </div>

            {/* Article Date & 2-Line Title */}
            <div class="relative z-10 pt-2">
              <span class="text-[10px] font-mono text-white/70 block mb-0.5 font-medium drop-shadow">
                {formattedDate}
              </span>
              <h3 class="text-xs sm:text-sm font-bold text-white group-hover:text-primary-400 transition-colors line-clamp-2 leading-snug drop-shadow-md">
                {post.data.title}
              </h3>
            </div>
          </div>
        );
      })}
    </div>

    {/* Recent Articles Mini Feed (Bottom Half) */}
    <div class="flex-1 flex flex-col justify-between pt-2 border-t border-white/10 min-h-0 gap-1.5">
      <span class="text-[10px] uppercase font-mono font-bold tracking-wider text-white/50">
        Recent Articles
      </span>

      <div class="flex flex-col justify-between flex-1 gap-2">
        {recentListPosts.map((post) => {
          const formattedDate = post.data.pubDate
            ? new Date(post.data.pubDate).toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
              })
            : "";

          return (
            <div class="group/post flex flex-col gap-0.5">
              <div class="flex items-center justify-between gap-1 text-[9.5px] text-white/50 font-mono">
                <span class="text-primary-400/90 font-semibold uppercase">{post.data.category || "TECH"}</span>
                <span>{formattedDate}</span>
              </div>
              <h4 class="text-xs font-semibold text-white/90 group-hover/post:text-primary-400 transition-colors line-clamp-1 leading-snug m-0">
                {post.data.title}
              </h4>
            </div>
          );
        })}
      </div>
    </div>
  </div>
</Card>

<script is:inline>
  (function setupBlogBillboard() {
    function initBillboard() {
      const container = document.querySelector('.blog-billboard-container');
      if (!container) return;

      const slides = container.querySelectorAll('.blog-slide');
      if (slides.length <= 1) return;

      if (container.dataset.initialized === 'true') return;
      container.dataset.initialized = 'true';

      let currentIndex = 0;
      let timer = null;

      function goToSlide(nextIndex) {
        slides.forEach((slide, idx) => {
          if (idx === nextIndex) {
            slide.classList.remove('opacity-0', 'z-0', 'scale-95', 'pointer-events-none');
            slide.classList.add('opacity-100', 'z-10', 'scale-100');
          } else {
            slide.classList.remove('opacity-100', 'z-10', 'scale-100');
            slide.classList.add('opacity-0', 'z-0', 'scale-95', 'pointer-events-none');
          }
        });
        currentIndex = nextIndex;
      }

      function startTimer() {
        stopTimer();
        timer = setInterval(() => {
          const next = (currentIndex + 1) % slides.length;
          goToSlide(next);
        }, 4000);
      }

      function stopTimer() {
        if (timer) clearInterval(timer);
      }

      container.addEventListener('mouseenter', stopTimer);
      container.addEventListener('mouseleave', startTimer);

      startTimer();
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initBillboard);
    } else {
      initBillboard();
    }
    document.addEventListener('astro:page-load', () => {
      const container = document.querySelector('.blog-billboard-container');
      if (container) container.dataset.initialized = 'false';
      initBillboard();
    });
  })();
</script>
