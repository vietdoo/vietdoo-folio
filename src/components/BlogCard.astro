---
import Card from "./Card/index.astro";
import { getPublishedPosts } from "../lib/blog";

const posts = await getPublishedPosts();

// Filter unique posts by translationKey to display distinct thumbnail covers
const uniquePostsMap = new Map();
for (const post of posts) {
  const key = post.data.translationKey || post.id;
  if (!uniquePostsMap.has(key) && post.data.image) {
    uniquePostsMap.set(key, post);
  }
}
const featuredPosts = Array.from(uniquePostsMap.values()).slice(0, 3);
const postCount = uniquePostsMap.size;
---

<Card
  href="/blog"
  colSpan="md:col-span-1"
  rowSpan="md:row-span-2"
  padding="p-4 sm:p-5"
>
  {/* Background Magazine Stack & Ambience */}
  <div slot="background" class="absolute inset-0 overflow-hidden pointer-events-none select-none" aria-hidden="true">
    {/* Ambient Glows */}
    <div class="absolute -top-10 -right-10 w-44 h-44 bg-primary-500/20 rounded-full blur-3xl group-hover:bg-primary-500/35 transition-all duration-700"></div>
    <div class="absolute -bottom-10 -left-10 w-44 h-44 bg-darkslate-400/40 rounded-full blur-2xl"></div>

    {/* Vignette Gradients for Text Contrast */}
    <div class="absolute inset-0 bg-gradient-to-t from-darkslate-800 via-darkslate-800/60 to-transparent z-10"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-darkslate-800/80 via-transparent to-darkslate-800/90 z-10"></div>

    {/* 3D Stacked Magazine Covers Container */}
    <div class="relative w-full h-full flex items-center justify-center pt-3 pb-12 px-3">
      {featuredPosts.map((post, index) => {
        const isBackLeft = index === 2;
        const isBackRight = index === 1;
        const isCenterFront = index === 0;

        return (
          <div
            class:list={[
              "absolute w-36 sm:w-40 aspect-[4/5] rounded-xl overflow-hidden shadow-2xl border transition-all duration-500 ease-out origin-bottom",
              isCenterFront && "z-20 border-white/20 group-hover:border-primary-400/70 shadow-black/90 rotate-[-2deg] group-hover:rotate-0 group-hover:scale-105 group-hover:-translate-y-1",
              isBackRight && "z-10 border-white/10 opacity-70 rotate-[9deg] translate-x-5 -translate-y-2 group-hover:rotate-[15deg] group-hover:translate-x-9 group-hover:-translate-y-4 group-hover:opacity-90",
              isBackLeft && "z-0 border-white/10 opacity-50 rotate-[-11deg] -translate-x-5 -translate-y-3 group-hover:rotate-[-17deg] group-hover:-translate-x-9 group-hover:-translate-y-5 group-hover:opacity-80"
            ]}
          >
            <img
              src={post.data.image}
              alt={post.data.title}
              class="w-full h-full object-cover filter brightness-[0.9] contrast-[1.05] group-hover:brightness-100 transition-all duration-500"
              loading="lazy"
            />
            {/* Magazine Cover Overlay */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/35 to-transparent p-2.5 flex flex-col justify-between">
              <span class="text-[9px] font-mono tracking-widest uppercase text-white/80 bg-black/50 backdrop-blur-md self-start px-1.5 py-0.5 rounded border border-white/10">
                {post.data.category || "JOURNAL"}
              </span>
              <div>
                <p class="text-[10px] font-semibold text-white/90 line-clamp-2 leading-tight drop-shadow-md">
                  {post.data.title}
                </p>
              </div>
            </div>
          </div>
        );
      })}
    </div>
  </div>

  {/* Foreground Content */}
  <div class="relative z-20 h-full flex flex-col justify-between pointer-events-none">
    {/* Top Bar Badges */}
    <div class="flex items-center justify-between">
      <span class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-full text-[10px] font-mono tracking-wider uppercase bg-darkslate-800/80 text-primary-400 border border-primary-500/30 backdrop-blur-md shadow-sm">
        <span class="w-1.5 h-1.5 rounded-full bg-primary-400 animate-pulse"></span>
        MAGAZINE
      </span>
      <span class="text-[10px] font-mono tracking-wider text-white/70 bg-black/50 px-2 py-0.5 rounded-md border border-white/10 backdrop-blur-sm">
        {postCount} ARTICLES
      </span>
    </div>

    {/* Bottom Title Block */}
    <div class="pt-4">
      <div class="flex items-baseline gap-2">
        <h2 class="text-xl sm:text-2xl font-bold m-0 text-white tracking-tight group-hover:text-primary-400 transition-colors">
          Blog
        </h2>
        <span class="text-[11px] font-mono text-white/50 tracking-widest uppercase">
          • ESSAYS
        </span>
      </div>
      <p class="text-xs text-white/70 line-clamp-1 mt-0.5 font-normal">
        Tech, AI architecture & engineering insights
      </p>
    </div>
  </div>
</Card>

