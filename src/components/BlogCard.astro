---
import Card from "./Card/index.astro";
import { getPublishedPosts } from "../lib/blog";

const posts = await getPublishedPosts();

// Filter unique posts by translationKey to avoid language duplicates
const uniquePostsMap = new Map();
for (const post of posts) {
  const key = post.data.translationKey || post.id;
  if (!uniquePostsMap.has(key)) {
    uniquePostsMap.set(key, post);
  }
}
const allPosts = Array.from(uniquePostsMap.values());
const latestPost = allPosts[0];
const postCount = allPosts.length;

const formattedDate = latestPost?.data.pubDate
  ? new Date(latestPost.data.pubDate).toLocaleDateString("en-US", {
      month: "short",
      year: "numeric",
    })
  : "";
---

<Card
  href="/blog"
  colSpan="md:col-span-1"
  rowSpan="md:row-span-2"
  padding="p-4 sm:p-5"
>
  {/* Background Image with Dark Slate Gradient Vignette */}
  <div slot="background" class="absolute inset-0 overflow-hidden pointer-events-none select-none" aria-hidden="true">
    {latestPost?.data.image && (
      <img
        src={latestPost.data.image}
        alt={latestPost.data.title}
        class="w-full h-full object-cover filter brightness-[0.65] contrast-[1.05] group-hover:scale-105 group-hover:brightness-[0.75] transition-all duration-500 ease-out"
        loading="lazy"
      />
    )}
    <div class="absolute inset-0 bg-gradient-to-t from-darkslate-500 via-darkslate-500/80 to-darkslate-500/40"></div>
  </div>

  {/* Content Layout */}
  <div class="relative z-10 h-full flex flex-col justify-between">
    {/* Top Label */}
    <div class="flex items-center justify-between">
      <span class="text-[11px] font-mono tracking-wider uppercase text-primary-400 font-medium">
        Latest Post
      </span>
      <span class="text-[10px] font-mono text-white/50">
        {postCount} posts
      </span>
    </div>

    {/* Center: Featured Article Preview */}
    {latestPost && (
      <div class="my-auto py-2">
        <span class="text-[10px] font-mono text-white/60 uppercase tracking-widest block mb-1">
          {latestPost.data.category || "ARTICLE"} • {formattedDate}
        </span>
        <h3 class="text-sm sm:text-base font-semibold text-white/90 group-hover:text-primary-400 transition-colors line-clamp-3 leading-snug">
          {latestPost.data.title}
        </h3>
      </div>
    )}

    {/* Bottom Section Header */}
    <div class="pt-2 border-t border-white/10 flex items-center justify-between">
      <h2 class="text-lg sm:text-xl font-bold m-0 text-white">
        Blog
      </h2>
      <span class="text-xs text-white/60 group-hover:text-white transition-colors">
        Read all &rarr;
      </span>
    </div>
  </div>
</Card>


