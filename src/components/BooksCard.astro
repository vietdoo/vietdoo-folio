---
import Card from "./Card/index.astro";
import { getLiveGoodreadsBooks } from "../lib/goodreads";
import { booksData as fallbackBooks } from "../data/books";

const liveBooks = await getLiveGoodreadsBooks();
const booksData = liveBooks.length > 0 ? liveBooks : fallbackBooks;
const currentlyReading = booksData.find((b) => b.status === "reading");
const shelfBooks = booksData.slice(0, 8);
const hasLiveBooks = liveBooks.length > 0;

const spineVariants = [
  {
    color: "#65321f",
    dark: "#34180f",
    accent: "#c78a48",
    height: 126,
    width: 25,
    tilt: -1.2,
  },
  {
    color: "#2d4d63",
    dark: "#152938",
    accent: "#7fb3c8",
    height: 139,
    width: 24,
    tilt: 0,
  },
  {
    color: "#4b4a45",
    dark: "#252522",
    accent: "#b8b19f",
    height: 113,
    width: 23,
    tilt: 0.8,
  },
  {
    color: "#15594f",
    dark: "#082f2a",
    accent: "#8bc8a5",
    height: 130,
    width: 27,
    tilt: -0.5,
  },
  {
    color: "#604526",
    dark: "#302211",
    accent: "#d0a466",
    height: 119,
    width: 22,
    tilt: 1.3,
  },
  {
    color: "#3f376e",
    dark: "#201a43",
    accent: "#a9a3e2",
    height: 139,
    width: 26,
    tilt: -0.4,
  },
  {
    color: "#3f4747",
    dark: "#202626",
    accent: "#a5b8b0",
    height: 115,
    width: 24,
    tilt: 0.5,
  },
  {
    color: "#1d5b66",
    dark: "#0c3038",
    accent: "#8ad1d0",
    height: 128,
    width: 25,
    tilt: -0.9,
  },
];
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-2 lg:col-start-4 lg:row-start-7"
  href="/books"
  height="min-h-[276px] sm:min-h-[300px] md:min-h-0 md:h-full"
  padding="p-3 sm:p-5"
  arrowCorner
>
  <div class="books-card-inner relative z-10 flex h-full select-none flex-col">
    <header class="books-card-header">
      <div>
        <h2 class="books-card-title">Bookshelf</h2>
        <p class="books-card-subtitle">
          {
            currentlyReading
              ? `Reading · ${currentlyReading.title}`
              : "Technical notes & personal reading log"
          }
        </p>
      </div>
      <div class="books-card-count" aria-label={`${booksData.length} books`}>
        <strong>{booksData.length}</strong>
        <span>books</span>
      </div>
    </header>

    <div class="bookshelf-scene" aria-label="A collection of books">
      <div class="book-row">
        {
          shelfBooks.map((book, idx) => {
            const variant = spineVariants[idx % spineVariants.length];
            const isLeaning = idx === 0 || idx === 4;
            return (
              <div
                class:list={["book-spine", isLeaning && "book-spine-leaning"]}
                style={`--book-color:${variant.color};--book-dark:${variant.dark};--book-accent:${variant.accent};--book-height:${variant.height}px;--book-width:${variant.width}px;--book-tilt:${variant.tilt}deg;`}
                title={`${book.title} — ${book.author}`}
                role="img"
                aria-label={`${book.title} by ${book.author}`}
              >
                <span class="book-top-rule" aria-hidden="true" />
                <span class="book-title">
                  {book.title.length > 30
                    ? `${book.title.slice(0, 28).trimEnd()}…`
                    : book.title}
                </span>
                <span class="book-author">{book.author}</span>
                <span class="book-bottom-rule" aria-hidden="true" />
              </div>
            );
          })
        }
      </div>
    </div>

    <footer class="books-card-footer">
      <span class="books-card-footer-label">
        <span
          class:list={["books-live-dot", hasLiveBooks && "books-live-dot-on"]}
        ></span>
        {hasLiveBooks ? "Live Goodreads shelf" : "Saved reading log"}
      </span>
      <span class="books-card-footer-link"
        >View bookshelf <span aria-hidden="true">↗</span></span
      >
    </footer>
  </div>
</Card>

<style>
  .books-card-inner {
    min-width: 0;
    min-height: 232px;
  }

  .books-card-header {
    display: flex;
    min-width: 0;
    align-items: flex-start;
    justify-content: space-between;
    gap: 12px;
  }

  .books-card-title {
    margin: 0;
    color: #f5f1e8 !important;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 1.12rem;
    font-weight: 700;
    letter-spacing: -0.035em;
    line-height: 1.1;
  }

  .books-card-subtitle {
    min-width: 0;
    max-width: 100%;
    margin: 6px 0 0;
    overflow: hidden;
    color: rgba(232, 226, 213, 0.61) !important;
    display: -webkit-box;
    font-size: 0.68rem;
    line-height: 1.35;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    text-overflow: ellipsis;
    white-space: normal;
  }

  .books-card-count {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    padding-top: 1px;
    color: rgba(232, 226, 213, 0.55) !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.6rem;
    line-height: 1.15;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .books-card-count strong {
    color: #d8bb7a !important;
    font-size: 0.95rem;
    font-weight: 500;
    letter-spacing: -0.04em;
  }

  .bookshelf-scene {
    position: relative;
    display: flex;
    min-height: 168px;
    flex: 1 1 auto;
    align-items: flex-end;
    justify-content: center;
    margin: 15px -3px 12px;
    padding: 8px 4px 0;
    background: transparent;
    perspective: 700px;
  }

  .bookshelf-crown {
    position: absolute;
    top: 6px;
    left: 13px;
    right: 13px;
    height: 6px;
    border: 1px solid rgba(49, 25, 13, 0.9);
    border-radius: 3px 3px 1px 1px;
    background:
      linear-gradient(
        90deg,
        rgba(255, 218, 152, 0.22),
        transparent 22%,
        rgba(36, 15, 7, 0.23) 55%,
        rgba(255, 231, 173, 0.14)
      ),
      #653d24;
    box-shadow:
      0 2px 3px rgba(0, 0, 0, 0.45),
      inset 0 1px rgba(255, 227, 173, 0.18);
  }

  .bookshelf-crown::after {
    position: absolute;
    right: 7%;
    bottom: 1px;
    left: 9%;
    height: 1px;
    background: rgba(244, 204, 139, 0.28);
    content: "";
  }

  .bookshelf-cabinet {
    position: relative;
    z-index: 1;
    overflow: hidden;
    min-height: 151px;
    border: 1px solid #2a140b;
    border-radius: 3px 3px 1px 1px;
    background: #5a331e;
    box-shadow:
      inset 7px 0 10px rgba(26, 10, 5, 0.38),
      inset -7px 0 10px rgba(26, 10, 5, 0.38),
      0 9px 13px rgba(0, 0, 0, 0.38);
    transform: rotateX(1deg);
  }

  .bookshelf-cabinet::before,
  .bookshelf-cabinet::after {
    position: absolute;
    z-index: 3;
    top: 0;
    bottom: 0;
    width: 5px;
    background: linear-gradient(
      90deg,
      rgba(255, 224, 160, 0.2),
      rgba(52, 20, 9, 0.42) 75%
    );
    content: "";
    pointer-events: none;
  }

  .bookshelf-cabinet::before {
    left: 0;
  }
  .bookshelf-cabinet::after {
    right: 0;
    transform: scaleX(-1);
  }

  .bookshelf-back {
    position: absolute;
    inset: 10px 8px 19px;
    border: 1px solid rgba(32, 13, 6, 0.73);
    border-radius: 1px;
    background:
      repeating-linear-gradient(
        95deg,
        transparent 0 17px,
        rgba(214, 150, 82, 0.07) 18px 19px,
        transparent 20px 38px
      ),
      linear-gradient(180deg, #3d2115 0%, #4f2a18 48%, #351b11 100%);
    box-shadow:
      inset 0 3px 9px rgba(0, 0, 0, 0.42),
      inset 0 -5px 10px rgba(0, 0, 0, 0.3);
  }

  .bookshelf-back::after {
    position: absolute;
    inset: 10px 12px;
    border-top: 1px solid rgba(226, 165, 98, 0.1);
    border-bottom: 1px solid rgba(226, 165, 98, 0.08);
    content: "";
  }

  .bookshelf-side-shadow {
    position: absolute;
    z-index: 2;
    top: 21px;
    bottom: 20px;
    width: 13px;
    background: linear-gradient(90deg, rgba(16, 6, 3, 0.42), transparent);
    pointer-events: none;
  }

  .bookshelf-side-shadow-left {
    left: 2px;
  }
  .bookshelf-side-shadow-right {
    right: 2px;
    transform: scaleX(-1);
  }

  .book-row {
    position: relative;
    z-index: 4;
    display: flex;
    width: 100%;
    align-items: flex-end;
    justify-content: center;
    gap: clamp(3px, 1vw, 7px);
    min-height: 145px;
    padding: 12px 5px 0;
  }

  .book-spine {
    position: relative;
    display: flex;
    width: var(--book-width);
    height: var(--book-height);
    min-width: 23px;
    flex: 1 1 var(--book-width);
    max-width: 42px;
    align-items: center;
    justify-content: space-between;
    overflow: hidden;
    padding: 7px 3px 6px;
    border: 1px solid color-mix(in srgb, var(--book-dark) 80%, #c58c4d 20%);
    border-radius: 2px 2px 0 0;
    background:
      linear-gradient(
        90deg,
        rgba(255, 239, 183, 0.11),
        transparent 15%,
        rgba(0, 0, 0, 0.15) 57%,
        rgba(255, 235, 176, 0.07)
      ),
      repeating-linear-gradient(
        170deg,
        transparent 0 10px,
        rgba(255, 235, 176, 0.045) 11px 12px
      ),
      linear-gradient(180deg, var(--book-color), var(--book-dark));
    box-shadow:
      inset 2px 0 2px rgba(255, 236, 184, 0.14),
      inset -3px 0 4px rgba(0, 0, 0, 0.3),
      2px 0 2px rgba(0, 0, 0, 0.28);
    cursor: pointer;
    transform: rotate(var(--book-tilt));
    transform-origin: bottom center;
    transition:
      transform 180ms cubic-bezier(0.23, 1, 0.32, 1),
      filter 180ms ease,
      margin 180ms ease;
  }

  .book-spine-leaning {
    margin-right: 1px;
  }

  .book-spine::before {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 2px;
    width: 1px;
    background: rgba(255, 234, 178, 0.23);
    content: "";
  }

  .book-spine:hover,
  .book-spine:focus-within {
    z-index: 8;
    filter: brightness(1.18) saturate(1.08);
    margin-top: -8px;
    transform: rotate(0deg) translateY(-4px);
  }

  .book-top-rule,
  .book-bottom-rule {
    display: block;
    width: 100%;
    height: 2px;
    flex: 0 0 auto;
    border-radius: 999px;
    background: var(--book-accent);
    opacity: 0.72;
    box-shadow: 0 0 2px rgba(255, 224, 158, 0.24);
  }

  .book-title {
    display: block;
    max-height: 108px;
    overflow: hidden;
    color: rgba(255, 247, 219, 0.98) !important;
    font-family: Georgia, "Times New Roman", serif;
    font-size: 0.48rem;
    font-weight: 700;
    line-height: 1.08;
    text-align: center;
    text-overflow: clip;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .book-author {
    max-height: 42px;
    overflow: hidden;
    color: color-mix(in srgb, var(--book-accent) 75%, #fff 25%) !important;
    font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
    font-size: 0.34rem;
    line-height: 1;
    opacity: 0.84;
    text-align: center;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
  }

  .bookshelf-lip {
    position: relative;
    z-index: 5;
    height: 9px;
    border: 1px solid #2e170b;
    border-radius: 1px 1px 2px 2px;
    background:
      linear-gradient(
        90deg,
        rgba(255, 212, 139, 0.2),
        transparent 24%,
        rgba(45, 16, 7, 0.24) 60%,
        rgba(239, 177, 98, 0.15)
      ),
      #6b4024;
    box-shadow:
      0 3px 4px rgba(0, 0, 0, 0.48),
      inset 0 1px rgba(255, 229, 174, 0.24),
      inset 0 -2px rgba(29, 10, 4, 0.32);
  }

  .bookshelf-lip::after {
    position: absolute;
    right: 8%;
    bottom: 2px;
    left: 8%;
    height: 1px;
    background: rgba(246, 199, 126, 0.28);
    content: "";
  }

  .bookshelf-base {
    position: relative;
    height: 7px;
    margin: -1px 7px 0;
    border-radius: 0 0 3px 3px;
    background: linear-gradient(180deg, #3b2114, #6a4024 46%, #2a140b);
    box-shadow: 0 5px 5px rgba(0, 0, 0, 0.42);
  }

  .bookshelf-base span {
    position: absolute;
    right: 8%;
    bottom: 2px;
    left: 8%;
    height: 1px;
    background: rgba(238, 185, 113, 0.2);
  }

  .books-card-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    border-top: 1px solid rgba(226, 218, 199, 0.1);
    padding-top: 9px;
    color: rgba(232, 226, 213, 0.48) !important;
    font-size: 0.62rem;
  }

  .books-card-footer-label {
    display: inline-flex;
    min-width: 0;
    align-items: center;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .books-live-dot {
    width: 5px;
    height: 5px;
    flex: 0 0 auto;
    margin-right: 5px;
    border: 1px solid rgba(216, 187, 122, 0.5);
    border-radius: 999px;
    background: rgba(216, 187, 122, 0.25);
  }

  .books-live-dot-on {
    border-color: #8bc8a5;
    background: #8bc8a5;
    box-shadow:
      0 0 0 2px rgba(139, 200, 165, 0.12),
      0 0 6px rgba(139, 200, 165, 0.62);
  }

  .books-card-footer-link {
    flex: 0 0 auto;
    color: #d8bb7a !important;
    font-weight: 600;
    transition:
      transform 180ms ease,
      color 180ms ease;
  }

  .books-card-footer-link span {
    display: inline-block;
  }

  .books-card-inner:hover .books-card-footer-link {
    color: #f0d59c !important;
    transform: translateX(2px);
  }

  @media (min-width: 768px) {
    .books-card-inner {
      min-height: 0;
    }

    .books-card-header > div:first-child {
      min-width: 0;
    }

    .books-card-subtitle {
      max-width: 100%;
    }

    .bookshelf-scene {
      min-width: 0;
      min-height: 0;
      margin: 8px 0 6px;
      padding: 2px 0 0;
      overflow: hidden;
    }

    .book-row {
      width: 100%;
      min-height: 0;
      gap: clamp(2px, 0.55vw, 5px);
      padding: 0 2px;
    }

    .book-spine {
      max-height: 132px;
    }

    .book-title {
      max-height: 92px;
      font-size: 0.43rem;
    }

    .book-author {
      max-height: 34px;
      font-size: 0.31rem;
    }

    .bookshelf-lip {
      height: 7px;
    }

    .bookshelf-base {
      height: 5px;
    }

    .books-card-footer {
      padding-top: 7px;
    }
  }

  @media (max-width: 420px) {
    .books-card-inner {
      min-height: 270px;
    }

    .books-card-header {
      gap: 8px;
    }

    .books-card-title {
      font-size: 1.05rem;
    }

    .books-card-subtitle {
      max-width: 100%;
      margin-top: 4px;
      font-size: 0.64rem;
    }

    .books-card-count {
      padding-top: 0;
      font-size: 0.56rem;
    }

    .books-card-count strong {
      font-size: 0.9rem;
    }

    .bookshelf-scene {
      min-width: 0;
      min-height: 162px;
      margin: 12px 0 10px;
      overflow: hidden;
      padding-inline: 0;
    }

    .book-row {
      width: 100%;
      min-width: 0;
      min-height: 136px;
      gap: 2px;
      padding: 10px 1px 0;
    }

    .book-spine {
      min-width: 22px;
      max-width: 35px;
      padding: 6px 2px 5px;
    }

    .book-title {
      max-height: 96px;
      font-size: 0.43rem;
    }

    .book-author {
      display: none;
    }

    .books-card-footer {
      gap: 6px;
      padding-top: 8px;
      font-size: 0.59rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .book-spine,
    .books-card-footer-link {
      transition: none;
    }
  }
</style>
