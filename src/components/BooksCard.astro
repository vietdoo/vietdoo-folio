---
import Card from "./Card/index.astro";
import { getLiveGoodreadsBooks } from "../lib/goodreads";
import { booksData as fallbackBooks } from "../data/books";

const liveBooks = await getLiveGoodreadsBooks();
const booksData = liveBooks.length > 0 ? liveBooks : fallbackBooks;

const currentlyReading = booksData.find((b) => b.status === "reading");
const shelfBooks = booksData.slice(0, 8);

// Varied spine colors, heights, and spine styles for authentic physical bookshelf feel
const spineVariants = [
  { bg: "bg-amber-950/80 border-amber-700/50 text-amber-200", height: "h-32", accent: "bg-amber-500/40" },
  { bg: "bg-slate-800 border-slate-600/60 text-slate-200", height: "h-36", accent: "bg-primary-400/40" },
  { bg: "bg-zinc-800 border-zinc-600/60 text-zinc-300", height: "h-28", accent: "bg-zinc-400/40" },
  { bg: "bg-emerald-950/80 border-emerald-700/50 text-emerald-200", height: "h-34", accent: "bg-emerald-400/40" },
  { bg: "bg-stone-800 border-stone-600/60 text-stone-300", height: "h-30", accent: "bg-amber-600/40" },
  { bg: "bg-indigo-950/80 border-indigo-700/50 text-indigo-200", height: "h-36", accent: "bg-indigo-400/40" },
  { bg: "bg-neutral-800 border-neutral-600/60 text-neutral-200", height: "h-31", accent: "bg-neutral-400/40" },
  { bg: "bg-cyan-950/80 border-cyan-700/50 text-cyan-200", height: "h-33", accent: "bg-cyan-400/40" },
];
---

<Card
  colSpan="md:col-span-1"
  rowSpan="md:row-span-2"
  href="/books"
  padding="p-4 sm:p-5"
>
  <div class="h-full flex flex-col justify-between relative z-10 select-none">
    {/* Header */}
    <div>
      <div class="flex items-baseline justify-between mb-1">
        <h2 class="text-base sm:text-lg font-bold text-white tracking-tight m-0">
          Bookshelf
        </h2>
        <span class="text-xs text-white/50 font-mono">
          {booksData.length} books
        </span>
      </div>

      {/* Minimal Status */}
      {currentlyReading ? (
        <p class="text-xs text-white/70 m-0 truncate">
          <span class="text-primary-400 font-medium">Reading:</span> {currentlyReading.title}
        </p>
      ) : (
        <p class="text-xs text-white/50 m-0">
          Technical notes & personal reading log
        </p>
      )}
    </div>

    {/* Physical Bookshelf Visual */}
    <div class="flex-1 flex flex-col justify-end my-3 relative min-h-[150px]">
      {/* Books Standing Upright on Shelf */}
      <div class="flex items-end justify-center gap-1.5 px-1 pb-1 relative z-10">
        {shelfBooks.map((book, idx) => {
          const variant = spineVariants[idx % spineVariants.length];
          const isLeaning = idx === 3; // Natural tilt for 1 book
          return (
            <div
              class={`bs-spine group relative flex flex-col items-center justify-between rounded-t-[3px] border-t border-x px-1 py-2.5 transition-all duration-300 ease-out cursor-pointer flex-1 max-w-[28px] sm:max-w-[32px] ${variant.bg} ${variant.height} ${
                isLeaning ? "rotate-3 translate-x-0.5" : ""
              } hover:-translate-y-2 hover:rotate-0 hover:shadow-lg hover:border-primary-400/80`}
              title={`${book.title} — ${book.author}`}
            >
              {/* Spine Top Accent Line */}
              <div class={`w-full h-0.5 rounded-full ${variant.accent}`}></div>

              {/* Vertical Title Text */}
              <span class="text-[9.5px] font-medium tracking-tight text-white/80 group-hover:text-white truncate max-h-[75px] [writing-mode:vertical-rl] rotate-180">
                {book.title}
              </span>

              {/* Spine Bottom Accent Line */}
              <div class={`w-full h-0.5 rounded-full ${variant.accent}`}></div>
            </div>
          );
        })}
      </div>

      {/* Wooden / Slate Shelf Bar */}
      <div class="w-full h-2.5 rounded-sm bg-gradient-to-r from-darkslate-600 via-darkslate-400/40 to-darkslate-600 border-t border-white/10 shadow-md"></div>
    </div>

    {/* Footer link */}
    <div class="flex items-center justify-between text-xs text-white/60 pt-1.5 border-t border-white/5">
      <span>Goodreads list</span>
      <span class="text-primary-400 group-hover:translate-x-1 transition-transform inline-flex items-center gap-0.5 font-medium">
        View bookshelf ↗
      </span>
    </div>
  </div>
</Card>
