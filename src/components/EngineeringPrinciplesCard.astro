---
import Card from "./Card/index.astro";
import { Icon } from "astro-icon/components";

const principles = [
  {
    icon: "ri:lightbulb-line",
    title: "Simplicity over cleverness",
    subtitle: "Small solutions age better than clever ones.",
  },
  {
    icon: "ri:line-chart-line",
    title: "Scale by design",
    subtitle: "Think beyond today's traffic.",
  },
  {
    icon: "ri:bar-chart-2-line",
    title: "Measure before optimize",
    subtitle: "Data beats assumptions.",
  },
  {
    icon: "ri:robot-3-line",
    title: "Automate everything repeatable",
    subtitle: "Humans solve problems, machines repeat them.",
  },
  {
    icon: "ri:shield-check-line",
    title: "Clean code survives longer",
    subtitle: "Readable code is maintainable code.",
  },
];
---

<Card colSpan="md:col-span-1" rowSpan="md:row-span-2" padding="p-3.5 sm:p-4">
  {/* Subtle dotted matrix decorative background */}
  <div
    slot="background"
    aria-hidden="true"
    class="absolute inset-x-0 bottom-0 h-24 pointer-events-none opacity-15 bg-[radial-gradient(var(--primary-400)_1.2px,transparent_1.2px)] [background-size:10px_10px] [mask-image:linear-gradient(to_bottom,transparent_0%,black_100%)] select-none"
  >
  </div>

  <div class="h-full flex flex-col justify-between relative z-10 select-none">
    {/* Top Header Section */}
    <div class="flex items-center justify-between gap-2 mb-1.5 flex-shrink-0">
      <h2 class="text-xs sm:text-sm font-bold text-white leading-tight m-0 tracking-tight flex items-center gap-1.5">
        <span>Engineering Principles</span>
      </h2>
      <div class="text-primary-400 p-0.5 shrink-0" aria-hidden="true">
        <Icon name="ri:code-s-slash-line" class="h-4 w-4 sm:h-5 sm:w-5" />
      </div>
    </div>

    {/* Principles List */}
    <ul class="space-y-1 sm:space-y-1.5 m-0 p-0 list-none flex-1 flex flex-col justify-around">
      {
        principles.map((item) => (
          <li class="flex items-center gap-2 group/item">
            <Icon
              name={item.icon}
              class="h-3.5 w-3.5 text-primary-400 shrink-0 group-hover/item:scale-110 transition-transform duration-150"
            />
            <div class="flex items-baseline justify-between w-full min-w-0 gap-1">
              <span class="text-[11px] font-semibold text-white/90 group-hover/item:text-primary-300 transition-colors duration-150 truncate">
                {item.title}
              </span>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Card>
