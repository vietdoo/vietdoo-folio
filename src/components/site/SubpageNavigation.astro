---
import { SubpageNavigation as SubpageNavSolid, type SubpageNavCta } from "./subpage-navigation";

interface Props {
  label: string;
  cta?: SubpageNavCta;
  showSearch?: boolean;
  searchPlaceholder?: string;
  showLangToggle?: boolean;
}

const { label, cta, showSearch, searchPlaceholder, showLangToggle } = Astro.props;
---

<SubpageNavSolid client:load label={label} cta={cta} showSearch={showSearch} searchPlaceholder={searchPlaceholder} showLangToggle={showLangToggle} />
