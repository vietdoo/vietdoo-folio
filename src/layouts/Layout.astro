---
import BasicLayout from "./BasicLayout.astro";

interface Props {
  title: string;
  description: string;
  page?: "travel";
  fullScreen?: string;
  keywords?: string[];
  hideSoundToggle?: boolean;
  hideCal?: boolean;
}

const { title, description, keywords, hideSoundToggle, hideCal } = Astro.props;
---

<BasicLayout
  description={description}
  title={title}
  keywords={keywords}
  hideSoundToggle={hideSoundToggle}
  hideCal={hideCal}
>
  <slot />
</BasicLayout>
