stateDiagram-v2
    [*] --> submitted
    submitted --> working: accepted
    submitted --> rejected: invalid / unauthorized
    working --> input_required: needs clarification
    input_required --> working: user replies
    working --> completed: artifact ready
    working --> failed: terminal error
    working --> canceled: cancel accepted
    input_required --> canceled: user cancels
    completed --> [*]
    failed --> [*]
    rejected --> [*]
    canceled --> [*]
